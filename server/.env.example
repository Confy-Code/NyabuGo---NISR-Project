# NyabuGo API configuration
PORT=4000
TICKET_SECRET=replace-with-a-long-random-secret

# Optional: Hugging Face Inference API token
# Enables Kinyarwanda translation (mbazaNLP/Nllb_finetuned_general_en_kin)
# and Whisper speech recognition (mbazaNLP/Whisper-Small-Kinyarwanda).
HF_TOKEN=
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models
HF_CHAT_MODEL=mbazaNLP/Nllb_finetuned_general_en_kin
HF_ASR_MODEL=mbazaNLP/Whisper-Small-Kinyarwanda
HF_TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
HF_FORECAST_MODEL=huggingface/Time-Series-Transformer
